# Supabase → your project → Connect → "Session pooler" connection string.
# Replace [YOUR-PASSWORD] with your database password. Never commit the real .env file.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres

# On Vercel use the "Transaction pooler" string (port 6543) instead.

# Optional locally, required in the cloud (see README → Deploy):
# APP_PASSWORD=   12+ characters; entered on the sign-in page
# MCP_SECRET=     32+ random letters/digits; enables /mcp/<secret> for Claude connectors
# APP_TZ=         e.g. Asia/Bangkok; the day Claude logs to when no date is given
